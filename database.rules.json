{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "email_index": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "contact_requests": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },
    "groups": {
      "$gid": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() == auth.uid) || (data.exists() && (data.child('createdBy').val() == auth.uid || data.child('members').child(auth.uid).exists())))"
      }
    },
    "group_invites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },
    "calls": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "call_hangup": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "signaling": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "fcm_tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
